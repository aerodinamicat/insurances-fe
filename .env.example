# Backend API base URL — must be reachable from the browser (host), not a Docker
# internal hostname. Used at build time by Vite (import.meta.env.VITE_API_URL).
# Default when unset: http://localhost:3001
VITE_API_URL=http://localhost:3001

# Optional — key for JWT storage in sessionStorage/localStorage
# VITE_JWT_STORAGE_KEY=insurances.accessToken
